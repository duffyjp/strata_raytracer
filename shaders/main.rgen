// main.rgen - ray generation: one primary ray per pixel, then the shared path-tracing loop.
//
// The transport loop lives in pt_common.glsl so the ray-query fallback traces the same paths.
#version 460 core
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_nonuniform_qualifier : require

#include "payload.glsl"

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevel;
layout(set = 0, binding = 1, rgba16f) uniform image2D hdrImage;

layout(location = 0) rayPayloadEXT RayHit rayHit;
layout(location = 1) rayPayloadEXT uint occludedFlag;

#include "pt_common.glsl"

// SBT layout (see src/main.cpp): hit region record 0 = hit.rchit, record 1 = shadow_hit.rchit;
// miss region record 0 = miss.rmiss, record 1 = shadow_miss.rmiss.
#define HIT_GROUP_SHADE   0u
#define HIT_GROUP_SHADOW  1u
#define MISS_GROUP_SCENE  0u
#define MISS_GROUP_SHADOW 1u

bool traceShadingRay(vec3 origin, vec3 direction, float tMax, out HitInfo hit) {
    rayHit.meta = vec4(0.0);   // meta.x == 0 means "nothing hit"
    traceRayEXT(topLevel, gl_RayFlagsOpaqueEXT, ALL_MASK,
                HIT_GROUP_SHADE, 0u, MISS_GROUP_SCENE,
                origin, 2e-3, direction, tMax, 0);
    if (rayHit.meta.x <= 0.0) {
        hit.hit = false;
        return false;
    }
    hit.hit = true;
    hit.pos = rayHit.posT.xyz;
    hit.t = rayHit.posT.w;
    hit.posObj = rayHit.posObj.xyz;
    hit.normal = normalize(rayHit.normal.xyz);
    hit.material = uint(rayHit.meta.x) - 1u;
    hit.kind = uint(rayHit.meta.y);
    hit.frontFacing = rayHit.meta.z > 0.5;
    return true;
}

bool occludedRay(vec3 origin, vec3 direction, float tMax) {
    occludedFlag = 0u;
    traceRayEXT(topLevel,
                gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, OCCLUDER_MASK,
                HIT_GROUP_SHADOW, 0u, MISS_GROUP_SHADOW,
                origin, 2e-3, direction, tMax, 1);
    return occludedFlag != 0u;
}

void main() {
    uvec2 pixel = gl_LaunchIDEXT.xy;
    ivec2 res = ivec2(uint(CAM_FRAME.x), uint(CAM_FRAME.y));
    if (pixel.x >= uint(res.x) || pixel.y >= uint(res.y)) return;

    uint base = uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + uint(CAM_POST.y) * 26699u + 1u;
    float tanHalf = CAM_ORIGIN_FOV.w;

    // CAM_DISPLAY.z samples per pixel per dispatched frame: more samples cost linearly but steady
    // the 1-sample-per-frame image that a moving camera otherwise shows.
    int spp = max(1, int(CAM_DISPLAY.z));
    vec3 sum = vec3(0.0);
    for (int s = 0; s < spp; ++s) {
        uint state = base + uint(s) * 7919u;
        state = pcgHash(state);  // pcgHash mutates its argument, so it needs a real variable
        vec2 jitter = vec2(rnd(state), rnd(state)) - 0.5;
        vec2 ndc = ((vec2(pixel) + 0.5 + jitter) / vec2(res)) * 2.0 - 1.0;
        vec3 dir = normalize(CAM_FWD.xyz
                             + CAM_RIGHT.xyz * (ndc.x * CAM_RIGHT.w * tanHalf)
                             + CAM_UP.xyz * (ndc.y * tanHalf));
        sum += pathTrace(CAM_ORIGIN_FOV.xyz, dir, state);
    }

    vec3 prev = CAM_FRAME.z > 0.5 ? vec3(0.0) : imageLoad(hdrImage, ivec2(pixel)).rgb;
    imageStore(hdrImage, ivec2(pixel), vec4(prev + max(sum, vec3(0.0)), 1.0));
}
