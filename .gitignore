# Build output. The exe and scene.pak are generated by build.ps1 from src, shaders and
# assets, so they are not vendored here. Grab the release download to run the app.
build/

# Logs and captured frames from development runs. Still images the README and DESIGN
# reference live in captures/ and are tracked; anything else is scratch.
*.log
raytracer.log
captures/accum_*.bin

# Experiment scratch: noise measurements, comparison runs, one-off patch scripts.
L_raw*/
L_f*/
cmp_*/
d_only/
d_view/
dump*/
rep*/
bit_*/
one8/
sweep/
z*/
_[A-Za-z0-9]*.py
_*.ps1
_*.txt
__pycache__/
# Vendored toolchain: unpacked from tools/glslang.zip by the shader build step, and far too
# large to publish. Keep it on disk; do not commit it.
tools/glslang/
tools/*.zip
tools/glslang-src/

# Release packaging scratch, produced by the workflow's package step.
pkg/
smoke/
